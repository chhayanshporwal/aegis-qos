# AegisQoS — Example Environment Configuration
# -----------------------------------------------
# WARNING: All values below are FICTITIOUS EXAMPLES.
# Do NOT commit real credentials to version control.

# WAN emulation defaults (tc netem parameters)
WAN_RATE_MBIT=100
WAN_DELAY_MS=20
WAN_JITTER_MS=5
WAN_LOSS_PCT=0.1

# FastAPI server
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit dashboard
DASHBOARD_PORT=8501

# Classification thresholds
CLASSIFIER_CONFIDENCE_THRESHOLD=0.65
CLASSIFIER_MODEL_PATH=models/flow_classifier.onnx

# Policy engine
HYSTERESIS_LOCK_SECONDS=3
BULK_STARVATION_FLOOR_PCT=15

# Safe-State Watchdog
WATCHDOG_CPU_THRESHOLD_PCT=10
WATCHDOG_INTERVAL_SECONDS=2

# Logging
LOG_LEVEL=INFO
